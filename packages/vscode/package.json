{
  "name": "neat",
  "displayName": "NEAT",
  "description": "Wire NEAT's MCP server into your editor and watch the local NEAT daemon from the status bar.",
  "version": "0.1.0",
  "private": true,
  "publisher": "neat",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://neat.is",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEAT-Technologies/Neat.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": ["AI", "Other"],
  "keywords": ["mcp", "neat", "graph", "observability", "ai"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "neat.mcpServerProvider",
        "label": "NEAT"
      }
    ],
    "commands": [
      {
        "command": "neat.configureMcp",
        "title": "NEAT: Configure MCP server for this editor"
      }
    ],
    "configuration": {
      "title": "NEAT",
      "properties": {
        "neat.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Base URL of the local NEAT daemon's REST API. The status bar polls its /health endpoint."
        },
        "neat.daemonToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional bearer token (ADR-073) sent to the daemon. Leave empty for a loopback-only daemon.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.101.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
